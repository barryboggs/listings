# =============================================================================
# Listing Manager — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values

# -----------------------------------------------------------------------------
# AUTH — Required
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=your-random-secret-here

# -----------------------------------------------------------------------------
# SEMRUSH API — Required for live data (app runs in demo mode without these)
# -----------------------------------------------------------------------------

# Option 1: Manual Bearer Token (quickest for testing)
# Get this from Semrush API settings or by running the OAuth flow once
SEMRUSH_BEARER_TOKEN=

# Option 2: Full OAuth (production)
# Register an app at Semrush to get these credentials
# SEMRUSH_CLIENT_ID=
# SEMRUSH_REFRESH_TOKEN=

# API base URL (you shouldn't need to change this)
# SEMRUSH_API_BASE=https://api.semrush.com/apis/v4-raw/listing-management/v1

# -----------------------------------------------------------------------------
# SEMRUSH RICH API — Optional, enables description / categories / coordinates /
# social fields via the newer local Listing Management API. Different
# credential type: an API key from the Semrush Subscription Info page (NOT
# the OAuth Bearer token above). Without it, those fields aren't editable.
# -----------------------------------------------------------------------------
SEMRUSH_API_KEY=

# Rich API base URL (you shouldn't need to change this)
# SEMRUSH_RICH_API_BASE=https://api.semrush.com/apis/v4/local/v1

# -----------------------------------------------------------------------------
# GOOGLE BUSINESS PROFILE — Optional, enables bulk photo pushes via the
# Google Business Profile Media API. Without these, the GBP routes return
# 503 "not configured" and the feature is hidden.
#
# Get these from Google Cloud Console → APIs & Services → Credentials.
# OAuth Client ID type: Web application.
# Authorized redirect URIs: https://<your-domain>/api/auth/google-bp/callback
#                           http://localhost:3000/api/auth/google-bp/callback
#
# Required Google Cloud APIs (must be enabled and approved by Google's GBP team):
#   - My Business Account Management API
#   - My Business Business Information API
# -----------------------------------------------------------------------------
GOOGLE_BP_CLIENT_ID=
GOOGLE_BP_CLIENT_SECRET=

# Optional — explicit redirect URI override. Defaults to the request origin +
# /api/auth/google-bp/callback, which works for both localhost and prod.
# GOOGLE_BP_REDIRECT_URI=

# -----------------------------------------------------------------------------
# VERCEL BLOB — Optional, enables drag-drop image upload on the bulk-push
# photos page (/dashboard/listings-photos). Without it the page falls back
# to URL-paste-only mode (image must already be hosted somewhere public).
#
# Create a Blob store in Vercel: Project → Storage → Blob → Create Store.
# The BLOB_READ_WRITE_TOKEN is auto-injected on Vercel deploys when the
# store is linked; add it to .env.local for local dev.
# -----------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=
