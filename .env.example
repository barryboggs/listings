# =============================================================================
# Listing Manager — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values

# -----------------------------------------------------------------------------
# AUTH — Required
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=your-random-secret-here

# -----------------------------------------------------------------------------
# SEMRUSH API — Required for live data (app runs in demo mode without these)
# -----------------------------------------------------------------------------

# Option 1: Manual Bearer Token (quickest for testing)
# Get this from Semrush API settings or by running the OAuth flow once
SEMRUSH_BEARER_TOKEN=

# Option 2: Full OAuth (production)
# Register an app at Semrush to get these credentials
# SEMRUSH_CLIENT_ID=
# SEMRUSH_REFRESH_TOKEN=

# API base URL (you shouldn't need to change this)
# SEMRUSH_API_BASE=https://api.semrush.com/apis/v4-raw/listing-management/v1

# -----------------------------------------------------------------------------
# SEMRUSH RICH API — Optional, enables description / categories / coordinates /
# social fields via the newer local Listing Management API. Different
# credential type: an API key from the Semrush Subscription Info page (NOT
# the OAuth Bearer token above). Without it, those fields aren't editable.
# -----------------------------------------------------------------------------
SEMRUSH_API_KEY=

# Rich API base URL (you shouldn't need to change this)
# SEMRUSH_RICH_API_BASE=https://api.semrush.com/apis/v4/local/v1
